<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch splash (API 21+): soft-green diagonal gradient +
     centered emblem. Shown by the OS while the Flutter engine starts;
     replaced by the Flutter splash route (same palette) on first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF243D2B"
                android:endColor="#FF4C8056"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_emblem" />
    </item>
</layer-list>
