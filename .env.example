# Copy to .env and fill from the issuing server (/home/aks/Documents/eid/.env).
# The app loads .env as a bundled asset (see pubspec.yaml assets + lib/main.dart).
# Never commit .env (gitignored) — it holds the CEK that decrypts encrypted QRs.
#
# Source of truth: eid server ENCRYPTION_KEY (64 hex chars = 32 bytes, AES-256).
# Generate a fresh one only together with a server re-enroll:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=PASTE_64_HEX_CHARS_FROM_EID_SERVER_HERE
